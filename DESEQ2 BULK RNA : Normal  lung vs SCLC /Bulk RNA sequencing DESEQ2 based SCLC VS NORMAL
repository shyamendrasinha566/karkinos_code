  keyType = "ENTREZID",
  ont = "BP",           # BP- BIOLOGICAL PROCESS
  pAdjustMethod = "BH",
  pvalueCutoff = 0.05,
  qvalueCutoff = 0.05,
  readable = TRUE
)

ego_df <- as.data.frame(ego)

head(ego_df)

dotplot(

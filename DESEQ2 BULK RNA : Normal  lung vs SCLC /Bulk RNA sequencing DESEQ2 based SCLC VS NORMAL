######## GENE SET ENRICHMENT ANALYSIS (GSEA) ###############

res_df <- res_df[
  !is.na(res_df$stat),
]

gene_map$ENSEMBL <- rownames(res_df)

head(gene_map)
head(res_df)

# ADD ENSEMBL COLUMN TO res_df 

res_df$ENSEMBL <- sub(
  "\\..*$",
  "",
  rownames(res_df)
)
gene_map1 <- bitr(
  unique(res_df$ENSEMBL),
  fromType = "ENSEMBL",
  toType = "ENTREZID",
  OrgDb = org.Hs.eg.db
)

merge_data <- merge(
  res_df,
  gene_map1,
  by = "ENSEMBL"
)


res_df$ENSEMBL <- rownames(res_df)

head(merge_data)

dim(merge_data)


# Remove missing or non-finite statistics

merge_data <- merge_data[
  !is.na(merge_data$stat) &
    is.finite(merge_data$stat),
]

# Remove duplicate ENTREZ IDs
merge_data <- merge_data[
  !duplicated(merge_data$ENTREZID),
]

# create ranked list 

gene_list <- merge_data$stat

names(gene_list) <- merge_data$ENTREZID

gene_list <- sort(gene_list, decreasing = TRUE)

############# RUN KEGG GSEA ##############

library(clusterProfiler)

gsea_result <- gseKEGG(
  geneList = gene_list,
  organism = "hsa",
  pvalueCutoff = 0.05
)

head(as.data.frame(gsea_result))

# VISUALIZE 

dotplot(
  gsea_result,
  showCategory = 20,
  title = "GSEA KEGG"
)

gseaplot2(
  gsea_result,
  geneSetID = 1,
  title = "KEGG Enrichment"
)


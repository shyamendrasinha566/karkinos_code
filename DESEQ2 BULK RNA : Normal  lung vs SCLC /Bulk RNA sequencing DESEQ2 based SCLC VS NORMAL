library(DESeq2)

counts <- read.delim("https://www.ebi.ac.uk/gxa/experiments-content/E-GEOD-60052/resources/DifferentialSecondaryDataFiles.RnaSeq/raw-counts")

head(counts)

metadata <- read.delim("https://www.ebi.ac.uk/gxa/experiments-content/E-GEOD-60052/resources/ExperimentDesignFile.RnaSeq/experiment-design")

dim(counts)
dim(metadata)


colnames(metadata)
head(metadata)

# EXTRACT GENE IDS 

gene_ids <- counts[,1]

# Remove gene ID column

count_matrix <- counts[, -1]

# ASSIGN GENEIDS AS ROWNAMES 

rownames(count_matrix) <- gene_ids

count_matrix <- count_matrix[,-1]

dim(count_matrix)


# LIBRARY SIZE - SEQUENCNG DEPTH 

library_size <- colSums(count_matrix)

barplot(
  library_size,
  las = 2,
  main = "Library Size Distribution",
  ylab = "Total Read Counts",
  col = "blue"
)

# Check disease groups

table(metadata$Factor.Value.disease.)
tbale(metadata$Run)

# CREATE COLDATA

coldata <- as.data.frame(metadata)

rownames(coldata) <- coldata$Run

coldata$condition <- factor(
  metadata$Factor.Value.disease.
)

colnames(metadata)
table(coldata$condition)
head(coldata)

# MATCH SAMPLE_ID 
# check whether all samples match 

all(colnames(count_matrix) %in% rownames(coldata))

# FILTER LOW QAUILTY GENES 

keep <- rowSums(count_matrix >= 10) >= 2

count_filter <- count_matrix[keep, ,drop = FALSE]

dim(count_filter)
dim(count_matrix)
colnames(count_matrix)
rownames(coldata)


# CREATE DESEQ2 OBJECT 

dds <- DESeqDataSetFromMatrix(
  countData = count_filter,
  colData = coldata,
  design = ~ condition
)

dds <- DESeq(dds)

dds

res <- results(
  dds,
  contrast = c("condition", "normal", "small cell lung carcinoma"),
  alpha = 0.05
)

summary(res)

res

# DDS RESULTS INTO DATAFRAME  

res_df <- as.data.frame(res)

# SIGNIFICANT GENES

sig_genes <- res_df[
  !is.na(res_df$padj) &
    res_df$padj < 0.05,
]

sig_genes <- sig_genes[
  order(sig_genes$padj),
  ,
  drop = FALSE
]

head(sig_genes)
nrow(sig_genes)


# UPREGULATED GENES

upreg_genes <- subset(
  sig_genes,
  log2FoldChange > 1
)

# TOP 20 UPRGUELATED GENES 

top_up <- upreg_genes[
  order(upreg_genes$log2FoldChange),
][1:20,]

top_up

# DOWNRGEULATED GENES 

down_genes <- subset(
  sig_genes,
  log2FoldChange < -1
)

# TOP 20 DOWNRGEULATED GENES 

top_down<- down_genes[
  order(down_genes$log2FoldChange),
] [1:20,]

top_down

nrow(upreg_genes)
nrow(down_genes)



# GENE SET ENRICHMENT ANALYSIS 

res_gsea <- as.data.frame(res)

res_gsea <- res_gsea[
  !is.na(res_gsea$stat),
]
  
gene_map <- bitr(
  rownames(res_gsea),
  fromType = "ENSEMBL",
  toType = "ENTREZID",
  OrgDb = org.Hs.eg.db
)

# Match statistics with gene IDs

res_gsea$ENSEMBL <- rownames(res_gsea)
  
  
# merge 

gsea_data <- merge(
  gene_map,
  res_gsea,
  by = "ENSEMBL"
)
  
gsea_data <- gsea_data[
  !duplicated(gsea_data$ENTREZID),
]

# Create ranked gene list

gene_list <- gsea_data$stat

names(gene_list) <- gsea_data$ENTREZID

gene_list <- sort(
  gene_list,
  decreasing = TRUE
)

# Run KEGG GSEA


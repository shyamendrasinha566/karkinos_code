library(maftools)
library(TCGAbiolinks)

# SEARCH THE FILE 

query <- GDCquery(
  project = "TCGA-ESCA",
  data.category = "Simple Nucleotide Variation",
  data.type = "Masked Somatic Mutation",
  workflow.type = "Aliquot Ensemble Somatic Variant Merging and Masking",
  access = "open"
)

getResults(query)
dim(query)
head(query)

# DOWNLOAD THE FILE 

GDCdownload(
  query = query,
  method = "api",
  directory = "GDCdata"
)

# PREPARE GDC DATA 

ESCA_data <- GDCprepare(
  query = query,
  directory = "GDCdata"
)

class(ESCA_data)
dim(ESCA_data)


# IMPORT INTO MAFTOOLS

ESC_MAF <- read.maf(ESCA_data)

ESC_MAF


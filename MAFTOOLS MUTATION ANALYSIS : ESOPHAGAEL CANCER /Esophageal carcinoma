# VARIANT ALLELE FREQUENCY (VAF)

ESC_VAF <- ESC_MAF[
  !is.na(ESC_MAF@data$t_alt_count) &
    !is.na(ESC_MAF@data$t_ref_count) &
    (ESC_MAF@data$t_alt_count + ESC_MAF@data$t_ref_count) > 0,
]

ESC_VAF$vaf <- with(
  ESC_MAF,
  t_alt_count / (t_alt_count + t_ref_count)
)

# INTO PERCENTAGE 

ESC_VAF$vaf_percent <- ESC_VAF$vaf * 100

summary(ESC_VAF$vaf)

dev.new()



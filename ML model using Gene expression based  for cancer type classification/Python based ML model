ml_df = pd.read_csv(
    r"C:\Users\Shyamendra Sinha\Desktop\R programming files\R PROGRAM\R OUTPUT FILES\ml_df.csv"
)

print(ml_df.head())
print(ml_df.shape)
print(pd.crosstab(ml_df["Dataset"], ml_df["Target"]))

# separate metadata and gene exp features 

metadata_col = ["Sample_ID","Dataset","Target"]

features_col = [
    col for col in ml_df.columns
    if col not in metadata_col
]

# SEPARATE METADATA AND FEATURE COLUMNS

metadata = ml_df[metadata_col]

print("No. of gene features:", len(features_col))



label_encoder = LabelEncoder()

y = label_encoder.fit_transform(ml_df["Target"])

print("Original classes:", label_encoder.classes_)

# DEFINE POSITIVE CLASS ONCE

POS_LABEL = label_encoder.transform(["HCC"])[0]

# Define confusion matrix order

CLASS_LABELS = label_encoder.transform(["HCC", "PAAD"])

print("Positive class (HCC):", POS_LABEL)
print("Class labels:", CLASS_LABELS)


# SET FEATURES
X = ml_df[features_col]

# SET TARGET
y = ml_df["Target"]

print("Features shape:", X.shape)
print("Target shape:", y.shape)


# Separate training and testing data

TRAIN_DATA = ml_df[ml_df["Dataset"] == "Train"].copy()

TEST_DATA = ml_df[ml_df["Dataset"] == "Test"].copy()


print("Training dataset:", TRAIN_DATA.shape)
print("Testing dataset:", TEST_DATA.shape)

# Separate features and target

X_train = TRAIN_DATA[features_col]
y_train = TRAIN_DATA["Target"]

X_test = TEST_DATA[features_col]
y_test = TEST_DATA["Target"]

# LABEL ENCODING

y_train = label_encoder.transform(TRAIN_DATA["Target"])


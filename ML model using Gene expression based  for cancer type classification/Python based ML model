    pos_label=POS_LABEL
)

cm_lr = confusion_matrix(
    y_test, y_pred_lr,
    labels=CLASS_LABELS
)

print("LOGISTIC REGRESSION")

print(f"Accuracy : {Accuracy_lr * 100:.1f}%")
